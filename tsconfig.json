{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node", "vite/client"],
    "customConditions": ["@numior/source"],
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "rootDirs": [".", "./node_modules/.cache/vue-dts"],
    "paths": {
      "#demo/*": ["./apps/docs/demo/ru/*", "./apps/docs/demo/shared/*"]
    }
  },
  "include": [
    "packages/**/*.ts",
    "packages/**/*.vue",
    "apps/**/*.ts",
    "apps/**/*.vue",
    "apps/docs/.vitepress/**/*.ts",
    "apps/docs/.vitepress/**/*.vue",
    "tests/**/*.ts",
    "scripts/**/*.ts",
    "*.config.ts"
  ],
  "exclude": [
    "**/node_modules",
    "**/dist",
    "**/.vitepress/cache",
    "**/.nuxt",
    "**/.output",
    "packages/nuxt/test/fixture"
  ]
}
