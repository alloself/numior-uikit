{
  "name": "@numior/table",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "@numior/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./engine": {
      "@numior/source": "./src/engine/index.ts",
      "types": "./dist/engine/index.d.ts",
      "import": "./dist/engine/index.js"
    },
    "./styles.css": {
      "@numior/source": "./src/styles.css",
      "default": "./dist/styles.css"
    },
    "./styles/*.css": {
      "@numior/source": "./src/*/*.css",
      "default": "./dist/styles/*.css"
    }
  },
  "scripts": {
    "build": "vp build && vue-tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@numior/forms": "workspace:*",
    "@numior/primitives": "workspace:*",
    "@numior/vue": "workspace:*",
    "@vueuse/core": "15.0.0",
    "lodash-es": "4.18.1"
  },
  "devDependencies": {
    "@types/lodash-es": "4.17.12",
    "@vue/test-utils": "2.5.1",
    "fast-check": "4.10.2"
  },
  "peerDependencies": {
    "@numior/tokens": "workspace:*",
    "vue": "^3.5.0"
  }
}
