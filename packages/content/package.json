{
  "name": "@numior/content",
  "version": "0.0.0",
  "private": false,
  "description": "Renders Numior editor documents in Vue or to an HTML string without the editor runtime.",
  "keywords": [
    "editor",
    "html",
    "numior",
    "numior-ui",
    "renderer",
    "rich-text",
    "ssr",
    "vue",
    "vue3"
  ],
  "homepage": "https://ui.numior.ru/en/editor/content",
  "bugs": {
    "url": "https://github.com/alloself/numior-uikit/issues"
  },
  "license": "MIT",
  "author": "Numior",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "@numior/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./table": {
      "@numior/source": "./src/table/index.ts",
      "types": "./dist/table/index.d.ts",
      "import": "./dist/table.js"
    },
    "./code": {
      "@numior/source": "./src/code/index.ts",
      "types": "./dist/code/index.d.ts",
      "import": "./dist/code.js"
    },
    "./media": {
      "@numior/source": "./src/media/index.ts",
      "types": "./dist/media/index.d.ts",
      "import": "./dist/media.js"
    },
    "./styles.css": {
      "@numior/source": "./src/styles.css",
      "default": "./dist/styles.css"
    },
    "./styles/*.css": {
      "@numior/source": "./src/*/*.css",
      "default": "./dist/styles/*.css"
    }
  },
  "scripts": {
    "build": "vp build && vue-tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@numior/editor-core": "workspace:*"
  },
  "devDependencies": {
    "@numior/primitives": "workspace:*",
    "@numior/table": "workspace:*",
    "@numior/vue": "workspace:*",
    "@vue/test-utils": "2.5.1"
  },
  "peerDependencies": {
    "@numior/primitives": "workspace:*",
    "@numior/table": "workspace:*",
    "@numior/tokens": "workspace:*",
    "@numior/vue": "workspace:*",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "@numior/table": {
      "optional": true
    }
  }
}
