{
  "name": "@numior/vue",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "@numior/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./controls": {
      "@numior/source": "./src/controls/index.ts",
      "types": "./dist/controls/index.d.ts",
      "import": "./dist/controls.js"
    },
    "./shiki": {
      "@numior/source": "./src/shiki/index.ts",
      "types": "./dist/shiki/index.d.ts",
      "import": "./dist/shiki.js"
    },
    "./styles.css": {
      "@numior/source": "./src/styles.css",
      "default": "./dist/styles.css"
    },
    "./styles/*.css": {
      "@numior/source": "./src/*/*.css",
      "default": "./dist/styles/*.css"
    }
  },
  "scripts": {
    "build": "vp build && vue-tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@numior/primitives": "workspace:*",
    "@vueuse/core": "15.0.0",
    "lucide-vue-next": "1.0.0"
  },
  "devDependencies": {
    "@vue/test-utils": "2.5.1",
    "shiki": "4.4.3"
  },
  "peerDependencies": {
    "@numior/tokens": "workspace:*",
    "shiki": "^4.4.3",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "shiki": {
      "optional": true
    }
  }
}
