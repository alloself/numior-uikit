{
  "name": "@numior/vue",
  "version": "0.0.0",
  "private": false,
  "description": "Vue 3 components of Numior UI: fields, lists, overlays, navigation and feedback, styled with Tailwind CSS 4.",
  "keywords": [
    "accessibility",
    "components",
    "numior",
    "numior-ui",
    "rtl",
    "ssr",
    "tailwindcss",
    "ui-kit",
    "vue",
    "vue3"
  ],
  "homepage": "https://ui.numior.ru/en/",
  "bugs": {
    "url": "https://github.com/alloself/numior-uikit/issues"
  },
  "license": "MIT",
  "author": "Numior",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "@numior/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./controls": {
      "@numior/source": "./src/controls/index.ts",
      "types": "./dist/controls/index.d.ts",
      "import": "./dist/controls.js"
    },
    "./styles.css": {
      "@numior/source": "./src/styles.css",
      "default": "./dist/styles.css"
    },
    "./styles/*.css": {
      "@numior/source": "./src/*/*.css",
      "default": "./dist/styles/*.css"
    }
  },
  "scripts": {
    "build": "vp build && vue-tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@numior/primitives": "workspace:*",
    "@vueuse/core": "15.0.0"
  },
  "devDependencies": {
    "@lucide/vue": "1.50.0",
    "@vue/test-utils": "2.5.1"
  },
  "peerDependencies": {
    "@numior/tokens": "workspace:*",
    "vue": "^3.5.0"
  }
}
