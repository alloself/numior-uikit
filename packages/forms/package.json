{
  "name": "@numior/forms",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "@numior/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vee-validate": {
      "@numior/source": "./src/vee-validate.ts",
      "types": "./dist/vee-validate.d.ts",
      "import": "./dist/vee-validate.js"
    },
    "./styles.css": {
      "@numior/source": "./src/styles.css",
      "default": "./dist/styles.css"
    },
    "./styles/*.css": {
      "@numior/source": "./src/components/*/*.css",
      "default": "./dist/styles/*.css"
    }
  },
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@numior/primitives": "workspace:*",
    "@numior/vue": "workspace:*"
  },
  "devDependencies": {
    "@vue/test-utils": "2.5.1",
    "vee-validate": "5.0.0-beta.1",
    "zod": "4.6.5"
  },
  "peerDependencies": {
    "@numior/tokens": "workspace:*",
    "vee-validate": "^5.0.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "vee-validate": {
      "optional": true
    }
  },
  "//": "vee-validate is only an optional peer of @numior/forms/vee-validate; the adapter is tested against 5.0.0-beta.1, see .archcore/forms.adr.md"
}
