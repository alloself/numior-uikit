{
  "name": "@numior/forms",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "@numior/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": {
      "@numior/source": "./src/styles.css",
      "default": "./dist/styles.css"
    },
    "./styles/*.css": {
      "@numior/source": "./src/components/*/*.css",
      "default": "./dist/styles/*.css"
    }
  },
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@numior/primitives": "workspace:*",
    "@numior/vue": "workspace:*",
    "klona": "2.0.6",
    "vee-validate": "5.0.0-beta.1"
  },
  "devDependencies": {
    "@vue/test-utils": "2.5.1",
    "zod": "4.6.5"
  },
  "peerDependencies": {
    "@numior/tokens": "workspace:*",
    "vue": "^3.5.0"
  },
  "//": "vee-validate is pinned to 5.0.0-beta.1 (no 5.x GA yet); the reason and the upgrade trigger live in .archcore/forms.adr.md"
}
