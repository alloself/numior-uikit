{
  "name": "@numior/forms",
  "version": "0.0.0",
  "private": false,
  "description": "Vue 3 forms with built-in and async rules, server errors and Standard Schema validators such as Zod, Valibot and ArkType.",
  "keywords": [
    "arktype",
    "forms",
    "numior",
    "numior-ui",
    "standard-schema",
    "valibot",
    "validation",
    "vue",
    "vue3",
    "zod"
  ],
  "homepage": "https://ui.numior.ru/en/components/form",
  "bugs": {
    "url": "https://github.com/alloself/numior-uikit/issues"
  },
  "license": "MIT",
  "author": "Numior",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "@numior/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": {
      "@numior/source": "./src/styles.css",
      "default": "./dist/styles.css"
    },
    "./styles/*.css": {
      "@numior/source": "./src/components/*/*.css",
      "default": "./dist/styles/*.css"
    }
  },
  "scripts": {
    "build": "vp build && vue-tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@numior/primitives": "workspace:*",
    "@numior/vue": "workspace:*",
    "lodash-es": "4.18.1"
  },
  "devDependencies": {
    "@types/lodash-es": "4.17.12",
    "@vue/test-utils": "2.5.1",
    "zod": "4.6.5"
  },
  "peerDependencies": {
    "@numior/tokens": "workspace:*",
    "vue": "^3.5.0"
  }
}
