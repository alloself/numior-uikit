{
  "name": "@numior/primitives",
  "version": "0.0.0",
  "private": false,
  "description": "Unstyled behavior for Vue 3: layers, lists, fields, file upload, dates, numbers and the color scheme.",
  "keywords": [
    "accessibility",
    "composables",
    "floating",
    "headless",
    "numior",
    "numior-ui",
    "virtual-list",
    "vue",
    "vue3"
  ],
  "homepage": "https://ui.numior.ru/en/",
  "bugs": {
    "url": "https://github.com/alloself/numior-uikit/issues"
  },
  "license": "MIT",
  "author": "Numior",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@numior/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./address": {
      "@numior/source": "./src/address/address.ts",
      "types": "./dist/address/address.d.ts",
      "import": "./dist/address.js"
    },
    "./guards": {
      "@numior/source": "./src/guards/guards.ts",
      "types": "./dist/guards/guards.d.ts",
      "import": "./dist/guards.js"
    },
    "./shiki": {
      "@numior/source": "./src/shiki/index.ts",
      "types": "./dist/shiki/index.d.ts",
      "import": "./dist/shiki.js"
    }
  },
  "scripts": {
    "build": "vp build && vue-tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@floating-ui/dom": "1.8.0",
    "@vueuse/core": "15.0.0",
    "lodash-es": "4.18.1"
  },
  "devDependencies": {
    "@types/lodash-es": "4.17.12",
    "@vue/test-utils": "2.5.1",
    "shiki": "4.4.3"
  },
  "peerDependencies": {
    "shiki": "^4.4.3",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "shiki": {
      "optional": true
    }
  }
}
