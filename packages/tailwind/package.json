{
  "name": "@numior/tailwind",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "@numior/source": "./src/theme.css",
      "default": "./dist/theme.css"
