{
  "name": "@numior/tailwind",
  "version": "0.0.0",
  "private": false,
  "description": "Tailwind CSS 4 preset on the Numior UI tokens.",
  "keywords": [
    "design-tokens",
    "numior",
    "numior-ui",
    "tailwind-preset",
    "tailwindcss",
    "vue",
    "vue3"
  ],
  "homepage": "https://ui.numior.ru/en/guide/tailwind",
  "bugs": {
    "url": "https://github.com/alloself/numior-uikit/issues"
  },
  "license": "MIT",
  "author": "Numior",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "@numior/source": "./src/theme.css",
      "default": "./dist/theme.css"
    },
    "./theme.css": {
      "@numior/source": "./src/theme.css",
      "default": "./dist/theme.css"
    }
  },
  "scripts": {
    "build": "pnpm -w build:css tailwind"
  },
  "peerDependencies": {
    "@numior/tokens": "workspace:*",
    "tailwindcss": "^4.0.0"
  }
}
