{
  "name": "@numior/spreadsheet",
  "version": "0.0.0",
  "private": false,
  "description": "Spreadsheet for Vue 3 with Excel formulas, XLSX open and save, conditional formats, pivot tables and charts.",
  "keywords": [
    "excel",
    "formulas",
    "numior",
    "numior-ui",
    "spreadsheet",
    "vue",
    "vue3",
    "workbook",
    "xlsx"
  ],
  "homepage": "https://ui.numior.ru/en/components/spreadsheet",
  "bugs": {
    "url": "https://github.com/alloself/numior-uikit/issues"
  },
  "license": "MIT",
  "author": "Numior",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "@numior/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "@numior/source": "./src/core/index.ts",
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./xlsx": {
      "@numior/source": "./src/xlsx/index.ts",
      "types": "./dist/xlsx/index.d.ts",
      "import": "./dist/xlsx/index.js"
    },
    "./styles.css": {
      "@numior/source": "./src/styles.css",
      "default": "./dist/styles.css"
    },
    "./styles/*.css": {
      "@numior/source": "./src/sheet/*.css",
      "default": "./dist/styles/*.css"
    }
  },
  "scripts": {
    "build": "vp build && vue-tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@lucide/vue": "1.50.0",
    "@numior/charts": "workspace:*",
    "@numior/primitives": "workspace:*",
    "@numior/table": "workspace:*",
    "@numior/vue": "workspace:*",
    "@vueuse/core": "15.0.0",
    "lodash-es": "4.18.1"
  },
  "devDependencies": {
    "@types/lodash-es": "4.17.12",
    "@vue/test-utils": "2.5.1",
    "fast-check": "4.10.2"
  },
  "peerDependencies": {
    "@numior/tokens": "workspace:*",
    "vue": "^3.5.0"
  }
}
