{
  "family": "logical",
  "provenance": "derived",
  "functions": [
    "IF",
    "AND",
    "OR",
    "NOT",
    "IFERROR",
    "IFS",
    "XOR",
    "TRUE",
    "FALSE",
    "IFNA",
    "SWITCH"
  ],
  "cases": [
    {
      "formula": "=IF(1>2,\"a\",\"b\")",
      "expected": "b"
    },
    {
      "formula": "=IF(FALSE,1)",
      "expected": false
    },
    {
      "formula": "=IF(TRUE,1,1/0)",
      "expected": 1
    },
    {
      "formula": "=AND(TRUE,1)",
      "expected": true
    },
    {
      "formula": "=AND(A1:A2)",
      "cells": {
        "A1": true,
        "A2": "x"
      },
      "expected": true
    },
    {
      "formula": "=AND(\"x\")",
      "expected": {
        "error": "#VALUE!"
      }
    },
    {
      "formula": "=OR(0,0)",
      "expected": false
    },
    {
      "formula": "=OR(A1:A2,FALSE)",
      "cells": {
        "A1": 0,
        "A2": 3
      },
      "expected": true
    },
    {
      "formula": "=NOT(1)",
      "expected": false
    },
    {
      "formula": "=IFERROR(#N/A,1)",
      "expected": 1
    },
    {
      "formula": "=IFERROR(5,1)",
      "expected": 5
    },
    {
      "formula": "=IFS(1>2,\"a\",TRUE,\"b\")",
      "expected": "b"
    },
    {
      "formula": "=IFS(FALSE,1)",
      "expected": {
        "error": "#N/A"
      }
    },
    {
      "formula": "=XOR(TRUE,TRUE,TRUE)",
      "expected": true
    },
    {
      "formula": "=XOR(TRUE,TRUE)",
      "expected": false
    },
    {
      "formula": "=TRUE()",
      "expected": true
    },
    {
      "formula": "=FALSE()",
      "expected": false
    },
    {
      "formula": "=IFNA(NA(),\"x\")",
      "expected": "x"
    },
    {
      "formula": "=IFNA(1/0,\"x\")",
      "expected": {
        "error": "#DIV/0!"
      }
    },
    {
      "formula": "=SWITCH(2,1,\"one\",2,\"two\")",
      "expected": "two"
    },
    {
      "formula": "=SWITCH(3,1,\"one\",\"other\")",
      "expected": "other"
    },
    {
      "formula": "=SWITCH(3,1,\"one\")",
      "expected": {
        "error": "#N/A"
      }
    }
  ]
}
