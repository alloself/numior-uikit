{
  "family": "arrays",
  "provenance": "derived",
  "functions": [
    "SEQUENCE",
    "TRANSPOSE",
    "FILTER",
    "SORT",
    "SORTBY",
    "UNIQUE",
    "TAKE",
    "DROP",
    "CHOOSEROWS",
    "CHOOSECOLS",
    "VSTACK",
    "HSTACK"
  ],
  "cases": [
    {
      "formula": "=SUM(SEQUENCE(4))",
      "expected": 10
    },
    {
      "formula": "=SEQUENCE(2,2,10,5)",
      "expected": [
        [10, 15],
        [20, 25]
      ]
    },
    {
      "formula": "=SEQUENCE(2,,3)",
      "expected": [[3], [4]]
    },
    {
      "formula": "=SEQUENCE(0)",
      "expected": {
        "error": "#CALC!"
      }
    },
    {
      "formula": "=TRANSPOSE({1,2})",
      "expected": [[1], [2]]
    },
    {
      "formula": "=FILTER({1;2;3},{TRUE;FALSE;TRUE})",
      "expected": [[1], [3]]
    },
    {
      "formula": "=FILTER({1,2,3},{1,0,1})",
      "expected": [[1, 3]]
    },
    {
      "formula": "=FILTER({1;2},{FALSE;FALSE},\"none\")",
      "expected": "none"
    },
    {
      "formula": "=FILTER({1;2},{FALSE;FALSE})",
      "expected": {
        "error": "#CALC!"
      }
    },
    {
      "formula": "=SORT({3;1;2})",
      "expected": [[1], [2], [3]]
    },
    {
      "formula": "=SORT({3;1;2},1,-1)",
      "expected": [[3], [2], [1]]
    },
    {
      "formula": "=SORT({\"b\",2;\"a\",1},2)",
      "expected": [
        ["a", 1],
        ["b", 2]
      ]
    },
    {
      "formula": "=SORT({3,1,2},1,1,TRUE)",
      "expected": [[1, 2, 3]]
    },
    {
      "formula": "=SORTBY({\"x\";\"y\";\"z\"},{3;1;2})",
      "expected": [["y"], ["z"], ["x"]]
    },
    {
      "formula": "=UNIQUE({1;2;1;3})",
      "expected": [[1], [2], [3]]
    },
    {
      "formula": "=UNIQUE({\"a\";\"A\";\"b\"})",
      "expected": [["a"], ["b"]]
    },
    {
      "formula": "=UNIQUE({1;2;1},FALSE,TRUE)",
      "expected": [[2]]
    },
    {
      "formula": "=TAKE({1;2;3},2)",
      "expected": [[1], [2]]
    },
    {
      "formula": "=TAKE({1;2;3},-1)",
      "expected": [[3]]
    },
    {
      "formula": "=TAKE({1,2;3,4},,1)",
      "expected": [[1], [3]]
    },
    {
      "formula": "=DROP({1;2;3},1)",
      "expected": [[2], [3]]
    },
    {
      "formula": "=DROP({1,2;3,4},,-1)",
      "expected": [[1], [3]]
    },
    {
      "formula": "=CHOOSEROWS({1;2;3},3,1)",
      "expected": [[3], [1]]
    },
    {
      "formula": "=CHOOSEROWS({1;2},-1)",
      "expected": [[2]]
    },
    {
      "formula": "=CHOOSECOLS({1,2,3},2)",
      "expected": [[2]]
    },
    {
      "formula": "=VSTACK({1,2},{3})",
      "expected": [
        [1, 2],
        [3, "#N/A"]
      ]
    },
    {
      "formula": "=HSTACK({1;2},{3})",
      "expected": [
        [1, 3],
        [2, "#N/A"]
      ]
    }
  ]
}
