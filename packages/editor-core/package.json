{
  "name": "@numior/editor-core",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@numior/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./fixtures": {
      "@numior/source": "./src/fixtures/index.ts",
      "types": "./dist/fixtures/index.d.ts",
      "import": "./dist/fixtures.js"
    },
    "./view": {
      "@numior/source": "./src/view/index.ts",
      "types": "./dist/view/index.d.ts",
      "import": "./dist/view.js"
    }
  },
  "scripts": {
    "build": "vp build && vue-tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "lodash-es": "4.18.1"
  },
  "devDependencies": {
    "@types/lodash-es": "4.17.12",
    "fast-check": "4.10.2"
  }
}
