{
  "name": "@numior/editor-vue",
  "version": "0.0.0",
  "private": false,
  "description": "Block editor for Vue 3 with history, Markdown shortcuts, an HTML or JSON v-model and SSR.",
  "keywords": [
    "block-editor",
    "editor",
    "markdown",
    "numior",
    "numior-ui",
    "rich-text",
    "vue",
    "vue3",
    "wysiwyg"
  ],
  "homepage": "https://ui.numior.ru/en/editor/",
  "bugs": {
    "url": "https://github.com/alloself/numior-uikit/issues"
  },
  "license": "MIT",
  "author": "Numior",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "@numior/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": {
      "@numior/source": "./src/styles.css",
      "default": "./dist/styles.css"
    },
    "./styles/*.css": {
      "@numior/source": "./src/*/*.css",
      "default": "./dist/styles/*.css"
    }
  },
  "scripts": {
    "build": "vp build && vue-tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@lucide/vue": "1.50.0",
    "@numior/content": "workspace:*",
    "@numior/editor-core": "workspace:*",
    "@numior/primitives": "workspace:*",
    "@numior/table": "workspace:*",
    "@numior/vue": "workspace:*",
    "@vueuse/core": "15.0.0"
  },
  "devDependencies": {
    "@vue/test-utils": "2.5.1"
  },
  "peerDependencies": {
    "@numior/tokens": "workspace:*",
    "vue": "^3.5.0"
  }
}
