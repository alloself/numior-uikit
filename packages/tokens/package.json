{
  "name": "@numior/tokens",
  "version": "0.0.0",
  "private": false,
  "description": "CSS tokens of Numior UI: light, dark and system themes, accents and density.",
  "keywords": [
    "css",
    "dark-mode",
    "design-tokens",
    "numior",
    "numior-ui",
    "tailwindcss",
    "theme",
    "vue",
    "vue3"
  ],
  "homepage": "https://ui.numior.ru/en/theme/tokens",
  "bugs": {
    "url": "https://github.com/alloself/numior-uikit/issues"
  },
  "license": "MIT",
  "author": "Numior",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./theme.css": {
      "@numior/source": "./src/theme.css",
      "default": "./dist/theme.css"
    },
    "./variants.css": {
      "@numior/source": "./src/variants.css",
      "default": "./dist/variants.css"
    },
    "./accents.css": {
      "@numior/source": "./src/accents.css",
      "default": "./dist/accents.css"
    },
    "./base.css": {
      "@numior/source": "./src/base.css",
      "default": "./dist/base.css"
    },
    "./prose.css": {
      "@numior/source": "./src/prose.css",
      "default": "./dist/prose.css"
    }
  },
  "scripts": {
    "build": "pnpm -w build:css tokens"
  },
  "peerDependencies": {
    "tailwindcss": "^4.0.0"
  }
}
