{
  "name": "@numior/charts",
  "version": "0.0.0",
  "private": false,
  "description": "SVG charts for Vue 3 that you explore with the keyboard, with a data table for screen readers.",
  "keywords": [
    "accessibility",
    "charts",
    "data-visualization",
    "numior",
    "numior-ui",
    "svg",
    "vue",
    "vue3"
  ],
  "homepage": "https://ui.numior.ru/en/components/charts",
  "bugs": {
    "url": "https://github.com/alloself/numior-uikit/issues"
  },
  "license": "MIT",
  "author": "Numior",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "@numior/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "@numior/source": "./src/core/index.ts",
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./styles.css": {
      "@numior/source": "./src/styles.css",
      "default": "./dist/styles.css"
    },
    "./styles/*.css": {
      "@numior/source": "./src/*/*.css",
      "default": "./dist/styles/*.css"
    }
  },
  "scripts": {
    "build": "vp build && vue-tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@numior/primitives": "workspace:*",
    "@vueuse/core": "15.0.0",
    "lodash-es": "4.18.1"
  },
  "devDependencies": {
    "@types/lodash-es": "4.17.12",
    "@vue/test-utils": "2.5.1",
    "fast-check": "4.10.2"
  },
  "peerDependencies": {
    "@numior/tokens": "workspace:*",
    "vue": "^3.5.0"
  }
}
