{
  "name": "numior-uikit",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @numior/playground dev",
    "docs:dev": "pnpm docs:reference && pnpm --filter @numior/docs dev",
    "docs:reference": "pnpm --filter @numior/docs reference",
    "build": "vp run --filter './packages/*' build && vp run --filter @numior/playground build",
    "docs:build": "pnpm --filter @numior/docs build && pnpm --filter @numior/docs check:dist",
    "docs:check": "pnpm --filter @numior/docs check",
    "lint": "vp run typecheck && vp lint --deny-warnings && eslint . --max-warnings 0",
    "format": "vp fmt --write .",
    "format:check": "vp fmt --check .",
    "analyze": "vp run analyze:dead-code && vp run analyze:dupes && vp run analyze:health",
    "analyze:dead-code": "fallow dead-code --fail-on-issues",
    "analyze:dupes": "fallow dupes --fail-on-issues",
    "analyze:health": "vp run test:coverage && fallow health --fail-on-issues --coverage node_modules/.cache/coverage/coverage-final.json",
    "test": "vp test run",
    "test:watch": "vp test",
    "test:e2e": "playwright test",
    "test:artifacts": "node scripts/check-artifacts.mjs",
    "test:ticks": "node scripts/check-tests.mjs",
    "check:styles": "node scripts/check-kit-styles.mjs",
    "arch:check": "archcore status",
    "check": "vp run --cache build && vp run docs:reference && vp run --cache format:check && vp run --cache typecheck && vp run lint && vp run --cache test:ticks && vp run --cache check:styles && vp run --cache test:budget && vp run --cache analyze && vp run --cache release:check && vp run --cache test:artifacts && vp run test:nuxt && vp run --cache docs:check && vp run docs:build",
    "build:css": "node scripts/build-css.ts",
    "release": "semantic-release",
    "release:dry-run": "semantic-release --dry-run",
    "release:check": "node --test scripts/release/*.test.mjs",
    "commitlint": "commitlint",
    "test:nuxt": "pnpm --filter @numior/nuxt exec vitest run --root ../.. --config packages/nuxt/vitest.config.ts",
    "parity:capture": "playwright test -c playwright.parity.config.ts",
    "parity:diff": "node tests/parity/cli.ts",
    "parity:css": "node tests/parity/css-cli.ts",
    "bench": "pnpm bench:engine && pnpm bench:editor && pnpm bench:spreadsheet && pnpm bench:browser",
    "bench:engine": "pnpm --filter @numior/table build && node --expose-gc packages/table/bench/engine.bench.ts",
    "bench:editor": "pnpm --filter @numior/editor-core build && node --expose-gc packages/editor-core/bench/core.bench.ts",
    "bench:spreadsheet": "pnpm --filter @numior/spreadsheet build && node --expose-gc packages/spreadsheet/bench/core.bench.ts",
    "bench:browser": "playwright test -c playwright.bench.config.ts",
    "corpus:libre": "pnpm --filter @numior/spreadsheet build && node packages/spreadsheet/crosscheck/libre.ts",
    "corpus:excel": "pnpm --filter @numior/spreadsheet build && node packages/spreadsheet/crosscheck/excel.ts",
    "bench:check": "node scripts/bench-check.mjs table && node scripts/bench-check.mjs vue && node scripts/bench-check.mjs editor-core && node scripts/bench-check.mjs spreadsheet"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@playwright/test": "1.63.0",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/github": "12.0.10",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@tailwindcss/node": "4.3.3",
    "@types/node": "^24.13.6",
    "@typescript-eslint/parser": "8.70.1",
    "@vitejs/plugin-vue": "6.0.9",
    "@vitest/coverage-v8": "catalog:",
    "conventional-changelog-conventionalcommits": "8.0.0",
    "eslint": "10.11.0",
    "eslint-plugin-vue": "10.11.0",
    "fallow": "3.27.0",
    "jsdom": "30.1.1",
    "semantic-release": "25.0.9",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "vue": "3.5.43",
    "vue-tsc": "3.3.11"
  },
  "engines": {
    "node": "^24.15.0",
    "pnpm": ">=10 <11"
  },
  "packageManager": "pnpm@10.31.0"
}
