{
  "name": "numior-uikit",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @numior/playground dev",
    "docs:dev": "pnpm docs:reference && pnpm --filter @numior/docs dev",
    "docs:reference": "pnpm --filter @numior/docs reference",
    "build": "pnpm -r --filter './packages/*' build && pnpm --filter @numior/playground build",
    "docs:build": "pnpm --filter @numior/docs build && pnpm --filter @numior/docs check:dist",
    "docs:check": "pnpm --filter @numior/docs check",
    "lint": "oxlint --deny-warnings && eslint . --max-warnings 0",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "analyze": "pnpm analyze:dead-code && pnpm analyze:dupes && pnpm analyze:health",
    "analyze:dead-code": "fallow dead-code --fail-on-issues",
    "analyze:dupes": "fallow dupes --fail-on-issues",
    "analyze:health": "pnpm test:coverage && fallow health --fail-on-issues --coverage coverage/coverage-final.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:artifacts": "node scripts/check-artifacts.mjs",
    "test:ticks": "node scripts/check-tests.mjs",
    "arch:check": "archcore status",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:ticks && pnpm analyze && pnpm release:check && pnpm build && pnpm test:artifacts && pnpm docs:check && pnpm docs:build",
    "build:css": "node scripts/build-css.ts",
    "release": "semantic-release",
    "release:dry-run": "semantic-release --dry-run",
    "release:check": "node --test scripts/release/*.test.mjs",
    "commitlint": "commitlint"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@playwright/test": "1.63.0",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/github": "12.0.10",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "^24.13.6",
    "@typescript-eslint/parser": "8.70.1",
    "@vitejs/plugin-vue": "6.0.9",
    "@vitest/coverage-v8": "5.0.1",
    "conventional-changelog-conventionalcommits": "8.0.0",
    "eslint": "10.11.0",
    "eslint-plugin-vue": "10.11.0",
    "fallow": "3.27.0",
    "jsdom": "30.1.1",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "semantic-release": "25.0.9",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "vue": "3.5.43",
    "vue-tsc": "3.3.11"
  },
  "engines": {
    "node": "^24.15.0",
    "pnpm": ">=10 <11"
  },
  "packageManager": "pnpm@10.31.0"
}
