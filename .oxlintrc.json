{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "vue", "vitest", "promise"],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "rules": {
    "no-debugger": "error",
    "eqeqeq": "error",
    "curly": ["error", "all"],
    "func-style": ["error", "expression"],
    "prefer-arrow-callback": "error",
    "import/no-unassigned-import": [
      "error",
      {
        "allow": ["**/*.css"]
      }
    ]
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/coverage/**",
    "**/.vitepress/cache/**",
    "playwright-report/**",
    "test-results/**",
    ".release/**"
  ]
}
