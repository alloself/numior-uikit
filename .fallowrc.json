{
  "$schema": "./node_modules/fallow/schema.json",
  "entry": [
    "packages/primitives/src/index.ts",
    "packages/vue/src/index.ts",
    "packages/forms/src/index.ts",
    "packages/table/src/engine/index.ts",
    "packages/table/src/index.ts",
    "packages/editor-core/src/index.ts",
    "packages/editor-core/src/fixtures/index.ts",
    "packages/editor-core/src/view/index.ts",
    "packages/content/src/index.ts",
    "packages/content/src/table/index.ts",
    "packages/editor-vue/src/index.ts",
    "apps/playground/src/tailwind.css",
    "scripts/vite-package-assets.ts",
    "scripts/build-css.ts",
    "apps/docs/scripts/check-examples.ts",
    "apps/docs/examples/**/*.vue",
    "apps/docs/scripts/reference.ts",
    "apps/docs/api/*.ts",
    "apps/docs/scripts/check-content.ts",
    "apps/docs/scripts/check-dist.ts",
    "packages/nuxt/src/module.ts",
    "packages/nuxt/src/runtime/plugin.ts",
    "packages/nuxt/vitest.config.ts",
    "packages/nuxt/test/fixture/nuxt.config.ts",
    "packages/nuxt/test/fixture/app/app.config.ts",
    "packages/nuxt/test/fixture/app/**/*.vue",
    "packages/nuxt/test/**/*.test.ts",
    "packages/table/bench/engine.bench.ts",
    "packages/editor-core/bench/core.bench.ts",
    "playwright.bench.config.ts",
    "tests/bench/**/*.spec.ts",
    "apps/playground/src/bench/main.ts"
  ],
  "includeEntryExports": false,
  "ignorePatterns": [
    "**/dist/**",
    "**/coverage/**",
    "**/.vitepress/cache/**",
    "playwright-report/**",
    "test-results/**",
    ".release/**",
    "apps/docs/test/fixtures/**",
    "**/.nuxt/**",
    "**/.output/**"
  ],
  "rules": {
    "unused-files": "error",
    "unused-exports": "error",
    "unused-types": "error",
    "unused-dependencies": "error",
    "unused-dev-dependencies": "error",
    "unlisted-dependencies": "error",
    "unresolved-imports": "error",
    "circular-dependencies": "error",
    "boundary-violation": "error"
  },
  "boundaries": {
    "zones": [
      {
        "name": "tokens",
        "patterns": ["packages/tokens/**"]
      },
      {
        "name": "primitives",
        "patterns": ["packages/primitives/**"]
      },
      {
        "name": "tailwind",
        "patterns": ["packages/tailwind/**"]
      },
      {
        "name": "vue",
        "patterns": ["packages/vue/**"]
      },
      {
        "name": "forms",
        "patterns": ["packages/forms/**"]
      },
      {
        "name": "table",
        "patterns": ["packages/table/**"]
      },
      {
        "name": "editor-core",
        "patterns": ["packages/editor-core/**"]
      },
      {
        "name": "content-table",
        "patterns": ["packages/content/src/table/**", "packages/content/test/table/**"]
      },
      {
        "name": "content",
        "patterns": ["packages/content/**"]
      },
      {
        "name": "editor-vue",
        "patterns": ["packages/editor-vue/**"]
      },
      {
        "name": "nuxt",
        "patterns": ["packages/nuxt/**"]
      },
      {
        "name": "apps",
        "patterns": ["apps/**"]
      },
      {
        "name": "tests",
        "patterns": ["tests/**"]
      }
    ],
    "rules": [
      {
        "from": "tokens",
        "allow": []
      },
      {
        "from": "primitives",
        "allow": ["primitives"]
      },
      {
        "from": "tailwind",
        "allow": ["tokens"]
      },
      {
        "from": "vue",
        "allow": ["tokens", "primitives", "vue"]
      },
      {
        "from": "forms",
        "allow": ["tokens", "primitives", "vue", "forms"]
      },
      {
        "from": "table",
        "allow": ["tokens", "primitives", "vue", "forms", "table"]
      },
      {
        "from": "editor-core",
        "allow": ["editor-core"]
      },
      {
        "from": "content-table",
        "allow": ["tokens", "primitives", "vue", "table", "editor-core", "content", "content-table"]
      },
      {
        "from": "content",
        "allow": ["tokens", "editor-core", "content"]
      },
      {
        "from": "editor-vue",
        "allow": [
          "tokens",
          "primitives",
          "vue",
          "table",
          "editor-core",
          "content",
          "content-table",
          "editor-vue"
        ]
      },
      {
        "from": "nuxt",
        "allow": ["tokens", "primitives", "vue", "forms", "table", "nuxt"]
      },
      {
        "from": "apps",
        "allow": [
          "tokens",
          "primitives",
          "tailwind",
          "vue",
          "forms",
          "table",
          "editor-core",
          "content",
          "content-table",
          "editor-vue",
          "nuxt",
          "apps"
        ]
      },
      {
        "from": "tests",
        "allow": [
          "tokens",
          "primitives",
          "tailwind",
          "vue",
          "forms",
          "table",
          "editor-core",
          "content",
          "content-table",
          "editor-vue",
          "nuxt",
          "apps",
          "tests"
        ]
      }
    ]
  },
  "duplicates": {
    "minTokens": 100,
    "threshold": 0.001,
    "ignore": ["**/*.messages.ts", "apps/docs/examples/**"]
  },
  "health": {
    "maxCyclomatic": 15,
    "maxCognitive": 15,
    "maxUnitSize": 80
  },
  "resolve": {
    "conditions": ["@numior/source"]
  },
  "ignoreDependencies": [
    "conventional-changelog-conventionalcommits",
    "@localSearchIndex",
    "virtual:nui-examples",
    "virtual:nui-reference",
    "#components"
  ]
}
