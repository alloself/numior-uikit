{
  "$schema": "./node_modules/fallow/schema.json",
  "entry": [
    "packages/primitives/src/index.ts",
    "packages/primitives/src/guards/guards.ts",
    "packages/vue/src/index.ts",
    "packages/forms/src/index.ts",
    "packages/table/src/engine/index.ts",
    "packages/table/src/index.ts",
    "packages/editor-core/src/index.ts",
    "packages/editor-core/src/fixtures/index.ts",
    "packages/editor-core/src/view/index.ts",
    "packages/content/src/index.ts",
    "packages/content/src/table/index.ts",
    "packages/content/src/code/index.ts",
    "packages/content/src/media/index.ts",
    "packages/editor-vue/src/index.ts",
    "packages/spreadsheet/src/index.ts",
    "packages/spreadsheet/src/core/index.ts",
    "packages/spreadsheet/src/xlsx/index.ts",
    "packages/charts/src/index.ts",
    "packages/charts/src/core/index.ts",
    "packages/collaboration/src/index.ts",
    "packages/collaboration/src/vue/index.ts",
    "packages/collaboration/src/spreadsheet/index.ts",
    "packages/collaboration/src/yjs/index.ts",
    "packages/collaboration/server/main.ts",
    "packages/offline/src/index.ts",
    "apps/playground/src/tailwind.css",
    "scripts/vite-package-assets.ts",
    "scripts/build-css.ts",
    "scripts/vue-declarations.ts",
    "apps/docs/scripts/check-examples.ts",
    "apps/docs/examples/**/*.vue",
    "apps/docs/scripts/reference.ts",
    "apps/docs/api/*.ts",
    "apps/docs/scripts/check-content.ts",
    "apps/docs/scripts/check-dist.ts",
    "packages/nuxt/src/module.ts",
    "packages/nuxt/src/runtime/plugin.ts",
    "packages/nuxt/vitest.config.ts",
    "packages/nuxt/test/fixture/nuxt.config.ts",
    "packages/nuxt/test/fixture/app/app.config.ts",
    "packages/nuxt/test/fixture/app/**/*.vue",
    "packages/nuxt/test/**/*.test.ts",
    "packages/table/bench/engine.bench.ts",
    "packages/editor-core/bench/core.bench.ts",
    "packages/spreadsheet/bench/core.bench.ts",
    "packages/spreadsheet/crosscheck/libre.ts",
    "packages/spreadsheet/crosscheck/excel.ts",
    "playwright.bench.config.ts",
    "tests/bench/**/*.spec.ts",
    "apps/playground/src/bench/main.ts",
    "apps/playground/src/collab/main.ts",
    "apps/playground/collab-dev-server.ts"
  ],
  "includeEntryExports": false,
  "ignorePatterns": [
    "**/dist/**",
    "**/coverage/**",
    "**/.vitepress/cache/**",
    "playwright-report/**",
    "test-results/**",
    ".release/**",
    "apps/docs/test/fixtures/**",
    "**/.nuxt/**",
    "**/.output/**"
  ],
  "rules": {
    "unused-files": "error",
    "unused-exports": "error",
    "unused-types": "error",
    "unused-dependencies": "error",
    "unused-dev-dependencies": "error",
    "unlisted-dependencies": "error",
    "unresolved-imports": "error",
    "circular-dependencies": "error",
    "boundary-violation": "error"
  },
  "boundaries": {
    "zones": [
      {
        "name": "tokens",
        "patterns": ["packages/tokens/**"]
      },
      {
        "name": "primitives",
        "patterns": ["packages/primitives/**"]
      },
      {
        "name": "tailwind",
        "patterns": ["packages/tailwind/**"]
      },
      {
        "name": "vue",
        "patterns": ["packages/vue/**"]
      },
      {
        "name": "forms",
        "patterns": ["packages/forms/**"]
      },
      {
        "name": "table",
        "patterns": ["packages/table/**"]
      },
      {
        "name": "editor-core",
        "patterns": ["packages/editor-core/**"]
      },
      {
        "name": "content-table",
        "patterns": ["packages/content/src/table/**", "packages/content/test/table/**"]
      },
      {
        "name": "content-code",
        "patterns": ["packages/content/src/code/**", "packages/content/test/code/**"]
      },
      {
        "name": "content-media",
        "patterns": ["packages/content/src/media/**", "packages/content/test/media/**"]
      },
      {
        "name": "content",
        "patterns": ["packages/content/**"]
      },
      {
        "name": "editor-vue",
        "patterns": ["packages/editor-vue/**"]
      },
      {
        "name": "spreadsheet",
        "patterns": ["packages/spreadsheet/**"]
      },
      {
        "name": "charts",
        "patterns": ["packages/charts/**"]
      },
      {
        "name": "collaboration-vue",
        "patterns": [
          "packages/collaboration/src/styles.css",
          "packages/collaboration/src/vue/**",
          "packages/collaboration/test/vue/**"
        ]
      },
      {
        "name": "collaboration-spreadsheet",
        "patterns": [
          "packages/collaboration/src/spreadsheet/**",
          "packages/collaboration/test/spreadsheet/**"
        ]
      },
      {
        "name": "collaboration-server",
        "patterns": ["packages/collaboration/server/**"]
      },
      {
        "name": "collaboration-test",
        "patterns": ["packages/collaboration/test/**"]
      },
      {
        "name": "collaboration",
        "patterns": ["packages/collaboration/**"]
      },
      {
        "name": "offline",
        "patterns": ["packages/offline/**"]
      },
      {
        "name": "nuxt",
        "patterns": ["packages/nuxt/**"]
      },
      {
        "name": "apps",
        "patterns": ["apps/**"]
      },
      {
        "name": "tests",
        "patterns": ["tests/**"]
      }
    ],
    "rules": [
      {
        "from": "tokens",
        "allow": []
      },
      {
        "from": "primitives",
        "allow": ["primitives"]
      },
      {
        "from": "tailwind",
        "allow": ["tokens"]
      },
      {
        "from": "vue",
        "allow": ["tokens", "primitives", "vue"]
      },
      {
        "from": "forms",
        "allow": ["tokens", "primitives", "vue", "forms"]
      },
      {
        "from": "table",
        "allow": ["tokens", "primitives", "vue", "forms", "table"]
      },
      {
        "from": "editor-core",
        "allow": ["editor-core"]
      },
      {
        "from": "content-table",
        "allow": ["tokens", "primitives", "vue", "table", "editor-core", "content", "content-table"]
      },
      {
        "from": "content-code",
        "allow": ["tokens", "primitives", "vue", "editor-core", "content", "content-code"]
      },
      {
        "from": "content-media",
        "allow": ["tokens", "primitives", "vue", "editor-core", "content", "content-media"]
      },
      {
        "from": "content",
        "allow": ["tokens", "editor-core", "content"]
      },
      {
        "from": "editor-vue",
        "allow": [
          "tokens",
          "primitives",
          "vue",
          "table",
          "editor-core",
          "content",
          "content-table",
          "content-code",
          "editor-vue"
        ]
      },
      {
        "from": "spreadsheet",
        "allow": ["spreadsheet", "table", "charts", "primitives", "vue"]
      },
      {
        "from": "charts",
        "allow": ["primitives", "charts"]
      },
      {
        "from": "collaboration-vue",
        "allow": [
          "tokens",
          "primitives",
          "vue",
          "editor-core",
          "content",
          "editor-vue",
          "collaboration",
          "collaboration-vue"
        ]
      },
      {
        "from": "collaboration",
        "allow": ["editor-core", "collaboration"]
      },
      {
        "from": "offline",
        "allow": ["editor-core", "collaboration", "offline"]
      },
      {
        "from": "collaboration-spreadsheet",
        "allow": ["spreadsheet", "collaboration", "collaboration-vue", "collaboration-spreadsheet"]
      },
      {
        "from": "collaboration-server",
        "allow": ["editor-core", "content", "spreadsheet", "collaboration", "collaboration-server"]
      },
      {
        "from": "collaboration-test",
        "allow": [
          "editor-core",
          "content",
          "editor-vue",
          "spreadsheet",
          "collaboration",
          "collaboration-server",
          "collaboration-test"
        ]
      },
      {
        "from": "nuxt",
        "allow": ["tokens", "primitives", "vue", "forms", "table", "nuxt"]
      },
      {
        "from": "apps",
        "allow": [
          "collaboration-server",
          "tokens",
          "primitives",
          "tailwind",
          "vue",
          "forms",
          "table",
          "editor-core",
          "content",
          "content-table",
          "content-code",
          "content-media",
          "editor-vue",
          "spreadsheet",
          "charts",
          "collaboration",
          "collaboration-vue",
          "collaboration-spreadsheet",
          "offline",
          "nuxt",
          "apps"
        ]
      },
      {
        "from": "tests",
        "allow": [
          "tokens",
          "primitives",
          "tailwind",
          "vue",
          "forms",
          "table",
          "editor-core",
          "content",
          "content-table",
          "content-code",
          "content-media",
          "editor-vue",
          "spreadsheet",
          "charts",
          "collaboration",
          "collaboration-vue",
          "offline",
          "nuxt",
          "apps",
          "tests"
        ]
      }
    ]
  },
  "duplicates": {
    "minTokens": 100,
    "threshold": 0.001,
    "ignore": ["**/*.messages.ts", "apps/docs/examples/**"]
  },
  "health": {
    "maxCyclomatic": 15,
    "maxCognitive": 15,
    "maxUnitSize": 80
  },
  "resolve": {
    "conditions": ["@numior/source"]
  },
  "ignoreDependencies": [
    "conventional-changelog-conventionalcommits",
    "@localSearchIndex",
    "virtual:nui-examples",
    "virtual:nui-reference",
    "#components",
    "vite-plus"
  ]
}
